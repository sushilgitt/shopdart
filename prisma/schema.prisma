// DPS — shoppable videos for Shopify
//
// Design notes that matter when extending this file:
//  * Video is source-agnostic on purpose. `source` + `sourceRef` form the
//    VideoSource adapter boundary, so YouTube/Facebook can be added later
//    without touching the player, widgets or analytics.
//  * Everything the storefront needs is denormalised onto Widget.config and
//    published as a CDN-cached JSON blob. `configVersion` is the cache-bust key.
//  * VideoEvent is written from a fire-and-forget beacon and rolled up into
//    UsageCounter. Never bill straight off VideoEvent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// ---------------------------------------------------------------------------
// Merchant
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  BASIC
  PREMIUM
  ELITE
}

model Shop {
  id     String @id @default(cuid())
  domain String @unique // e.g. acme.myshopify.com

  name         String?
  email        String?
  currencyCode String?
  countryCode  String?
  timezone     String?

  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  onboardedAt   DateTime?

  plan          Plan      @default(FREE)
  planUpdatedAt DateTime?
  // Shopify AppSubscription GID. Null on the free plan.
  billingGid    String?

  // WebPixel GID, set once the analytics pixel is registered on this shop.
  // Cached so the admin does not re-query the Admin API on every page load;
  // null simply means "not registered yet", which is self-correcting.
  webPixelId String?

  // Instagram Graph API connection (merchant's own Business/Creator account).
  // igAccessToken is a long-lived token — encrypt before writing and never
  // include it in a loader response.
  igUserId         String?
  igUsername       String?
  igAccessToken    String?
  igTokenExpiresAt DateTime?
  igLastSyncedAt   DateTime?

  // YouTube. Read-only over a server-side API key against the merchant's
  // public channel — no OAuth, so there is no token to store or refresh.
  ytChannelId         String?
  ytChannelTitle      String?
  // Cached because resolving a handle costs an extra quota unit on every
  // browse, and the mapping never changes for a given channel.
  ytUploadsPlaylistId String?
  ytLastSyncedAt      DateTime?
  // Set once Google has confirmed the merchant owns this channel, via a
  // one-time OAuth grant. Browsing and importing refuse to run without it, so
  // a channel can never be attached by simply naming it.
  ytVerifiedAt        DateTime?

  // TikTok. There is no OAuth here: the Display API needs a developer app that
  // merchants cannot be asked to create, and it returns no video file anyway.
  // Ownership is therefore proven the way YouTube's is — a code only the
  // account holder can publish — and enforced on every import.
  ttUsername     String?
  // Set once the verification code was found in a post's caption on this
  // account. Importing refuses to run without it, so a handle can never be
  // attached by simply naming it.
  ttVerifiedAt   DateTime?
  ttLastSyncedAt DateTime?

  videos  Video[]
  widgets Widget[]
  events  VideoEvent[]
  usage   UsageCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uninstalledAt])
}

// ---------------------------------------------------------------------------
// Video library
// ---------------------------------------------------------------------------

enum VideoSource {
  UPLOAD
  INSTAGRAM
  // Embed-only. YouTube exposes no downloadable file, so the storefront runs
  // their iframe player instead of one of ours. Product tagging still works —
  // the cards are ours and sit over the frame — but MP4-first playback and
  // forced autoplay do not.
  YOUTUBE
  // Provenance, not a delivery route.
  //
  // No tier of TikTok's API returns a video file, so a TikTok post reaches us
  // the only way it can: the merchant supplies the original they filmed, it
  // goes to Bunny, and it plays exactly like any other upload. Recording the
  // source buys two things — the admin can link back to the post, and
  // @@unique([shopId, source, sourceRef]) stops the same post being added
  // twice, which a bare UPLOAD row cannot do.
  TIKTOK
  // Reserved. Embed-only, same shape as YouTube.
  FACEBOOK
}

enum VideoStatus {
  PENDING // row created, nothing sent to Bunny yet
  UPLOADING // bytes in flight to Bunny Stream
  PROCESSING // Bunny is transcoding
  READY // playable
  FAILED
}

model Video {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  source    VideoSource @default(UPLOAD)
  // External identity for imported videos: the Instagram media id, the YouTube
  // video id, or the TikTok post id. Null for direct uploads, which have no external
  // identity — the @@unique below exists to stop the same remote video being
  // imported twice, and uploads must not be deduped by it.
  sourceRef String?
  // Permalink back to the original post, shown in the admin.
  sourceUrl String?

  title   String?
  caption String?

  // Bunny Stream
  bunnyVideoId String?     @unique
  status       VideoStatus @default(PENDING)
  posterUrl    String?
  hlsUrl       String?
  // Progressive MP4 rendition. Preferred over HLS for clips under ~60s:
  // faster first frame and no hls.js payload on the storefront.
  mp4Url       String?
  durationSec  Float?
  width        Int?
  height       Int?
  sizeBytes    BigInt?
  errorMessage String?

  archivedAt DateTime?

  tags         ProductTag[]
  widgetVideos WidgetVideo[]
  events       VideoEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, source, sourceRef])
  @@index([shopId, status])
  @@index([shopId, createdAt])
}

// A product pinned to a video, optionally only between startSec and endSec.
model ProductTag {
  id      String @id @default(cuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  productGid String // gid://shopify/Product/123
  variantGid String? // optional pre-selected variant

  // Cached at tag time so the storefront payload needs no Admin API call.
  // Refreshed by the products/update webhook.
  handle       String?
  title        String?
  imageUrl     String?
  priceAmount  Decimal? @db.Decimal(12, 2)
  currencyCode String?

  // Cached variants, so the player can offer a size/colour picker without an
  // Admin API call. Shape: [{ id, title, price, available }].
  //
  // Without this, any product with more than one variant degrades to a link
  // out to the product page — which is most real products, and defeats the
  // point of a shoppable video.
  variants Json?

  startSec Float? @default(0)
  endSec   Float?
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, productGid])
  @@index([videoId, position])
  @@index([productGid])
}

// ---------------------------------------------------------------------------
// Widgets
// ---------------------------------------------------------------------------

enum WidgetLayout {
  GALLERY
  CAROUSEL
  STORIES
  FLOATING
  PRODUCT_PAGE
  POPUP
}

enum WidgetStatus {
  DRAFT
  PUBLISHED
}

model Widget {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name   String
  layout WidgetLayout
  status WidgetStatus @default(DRAFT)

  // Presentation only: colours, radius, autoplay, muted, CTA copy, aspect
  // ratio, items per row.
  config Json @default("{}")

  // Bumped on every save. The storefront fetches the widget payload from the
  // Bunny pull zone keyed on this value, so incrementing it is what makes an
  // edit go live.
  configVersion Int @default(1)

  publishedAt DateTime?

  videos     WidgetVideo[]
  placements Placement[]
  events     VideoEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
}

model WidgetVideo {
  widgetId String
  videoId  String
  position Int    @default(0)

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([widgetId, videoId])
  @@index([widgetId, position])
}

enum PlacementTarget {
  HOME
  PRODUCT
  COLLECTION
  CART
  ALL_PAGES
  CUSTOM
}

model Placement {
  id       String @id @default(cuid())
  widgetId String
  widget   Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  target      PlacementTarget
  // Scope to one resource, e.g. a single product GID. Null = every page of
  // that target type.
  targetRef   String?
  // Free-form path pattern when target is CUSTOM, e.g. "/pages/lookbook".
  pathPattern String?

  createdAt DateTime @default(now())

  @@index([widgetId])
  @@index([target, targetRef])
}

// ---------------------------------------------------------------------------
// Analytics + metering
// ---------------------------------------------------------------------------

enum EventType {
  IMPRESSION // widget scrolled into view
  VIEW_START // playback began — this is what counts against plan limits
  VIEW_COMPLETE
  PRODUCT_CLICK
  ADD_TO_CART
  CHECKOUT_STARTED
  PURCHASE // reconciled from the orders/create webhook
}

model VideoEvent {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  videoId  String?
  video    Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)
  widgetId String?
  widget   Widget? @relation(fields: [widgetId], references: [id], onDelete: SetNull)

  type EventType

  // Hashed per-browser-session key. Used to dedupe repeat impressions and to
  // stitch a purchase back to the video that drove it. Never a raw client id.
  sessionKey String
  productGid String?

  // Populated on PURCHASE only.
  orderGid     String?
  value        Decimal? @db.Decimal(12, 2)
  currencyCode String?

  occurredAt DateTime @default(now())

  // One purchase per order per video, however many beacons arrive.
  @@unique([orderGid, videoId, type])
  @@index([shopId, occurredAt])
  @@index([videoId, type])
  @@index([widgetId, type])
  @@index([sessionKey])
}

// Monthly rollup. Plan limits are enforced against this, never against a live
// count over VideoEvent.
model UsageCounter {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  period String // "2026-07"

  impressions Int     @default(0)
  views       Int     @default(0)
  clicks      Int     @default(0)
  addToCarts  Int     @default(0)
  orders      Int     @default(0)
  revenue     Decimal @default(0) @db.Decimal(14, 2)

  // Set when the shop crosses its plan's view cap, so we only notify once.
  capReachedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, period])
  @@index([period])
}
