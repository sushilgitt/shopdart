# Shopdart — copy to .env and fill in. Never commit .env.

# --- Shopify -----------------------------------------------------------------
# Populated by `npm run config:link` / `npm run dev`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,read_orders

# --- Database ----------------------------------------------------------------
# Postgres. Locally:
#   docker run --name shopdart-pg -e POSTGRES_PASSWORD=shopdart \
#     -e POSTGRES_DB=shopdart -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:shopdart@localhost:5432/shopdart

# --- Bunny Stream (video hosting + delivery) ---------------------------------
# Create a Stream library at https://dash.bunny.net/stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Pull-zone hostname for the library, e.g. vz-1234abcd.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Signs HLS/MP4 URLs when token authentication is enabled on the library.
BUNNY_STREAM_TOKEN_KEY=
# The library's READ-ONLY api key. Bunny signs transcode webhooks with this,
# not with BUNNY_STREAM_API_KEY. Without it /webhooks/bunny rejects everything.
BUNNY_STREAM_READONLY_KEY=

# --- Bunny CDN (widget config delivery) --------------------------------------
# A separate pull zone in front of this app. Widget settings are served from
# here so storefronts never hit our origin — see app/routes/app.widgets.tsx.
BUNNY_CONFIG_PULL_ZONE_ID=
BUNNY_ACCOUNT_API_KEY=
BUNNY_CONFIG_HOSTNAME=

# --- Instagram Graph API -----------------------------------------------------
# Meta app with Instagram Graph API. Only reads media from the Business or
# Creator account the merchant authorises.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# --- Crypto ------------------------------------------------------------------
# 32-byte base64 key used to encrypt stored Instagram access tokens.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
