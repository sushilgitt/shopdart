# Shopdart — copy to .env and fill in. Never commit .env.

# --- Shopify -----------------------------------------------------------------
# Populated by `npm run config:link` / `npm run dev`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products

# --- Database ----------------------------------------------------------------
# Postgres. Locally:
#   docker run --name shopdart-pg -e POSTGRES_PASSWORD=shopdart \
#     -e POSTGRES_DB=shopdart -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:shopdart@localhost:5432/shopdart

# --- Bunny Stream (video hosting + delivery) ---------------------------------
# Create a Stream library at https://dash.bunny.net/stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Pull-zone hostname for the library, e.g. vz-1234abcd.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# The library's READ-ONLY api key. Bunny signs transcode webhooks with this,
# not with BUNNY_STREAM_API_KEY. Without it /webhooks/bunny rejects everything.
BUNNY_STREAM_READONLY_KEY=


# --- Instagram -----------------------------------------------------------------
# "Instagram API with Instagram Login" (NOT the Facebook Login variant, which
# would force merchants to link a Facebook Page). Meta app dashboard →
# Instagram → API setup with Instagram login.
# Only instagram_business_basic is requested: read-only on the merchant's media.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match the redirect URI registered in the Meta app, byte for byte.
INSTAGRAM_REDIRECT_URI=https://shopdart.91.239.208.85.sslip.io/instagram/callback

# --- YouTube -------------------------------------------------------------------
# YouTube Data API v3 key from https://console.cloud.google.com
# Server-side only: restrict it by IP to this app's host, and to the YouTube
# Data API alone. No OAuth — public channel uploads need no user consent.
# Quota is 10,000 units/day for the WHOLE app, across every merchant.
YOUTUBE_API_KEY=

# --- Scheduled jobs ------------------------------------------------------------
# Bearer token for POST /api/cron/instagram-refresh. Generate:
#   openssl rand -hex 32
CRON_SECRET=

# --- Crypto ------------------------------------------------------------------
# 32-byte base64 key used to encrypt stored Instagram access tokens.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
